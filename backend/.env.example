# Configure at least one provider. Neither provider is individually required.
# Direct Kimi K3 (https://api.kimi.com/coding/v1):
KIMI_API_KEY=your-direct-kimi-key

# OpenRouter provides both registered OpenRouter choices:
#   moonshotai/kimi-k2.7-code
#   moonshotai/kimi-k3
OPENROUTER_API_KEY=your-openrouter-key

# Mistral (provider key "mistral-vibe") — same connection flow as Mistral's
# own CLI agent (github.com/mistralai/mistral-vibe): key from MISTRAL_API_KEY,
# server https://api.mistral.ai, default model mistral-medium-3-5.
MISTRAL_API_KEY=your-mistral-key

# Optional direct-Mistral model/base-url overrides
# MISTRAL_MODEL=mistral-medium-3-5
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# GLM 5.3 (provider key "mistral-glm-5.3") always thinks; the default effort
# here is "low" (the platform's serving default "high" burns ~30k thinking
# tokens on a small design round). Raise it if a complex design needs more:
# GLM_REASONING_EFFORT=high   (accepted: low | high | max)

# Optional direct-Kimi model/base-url overrides (not used by OpenRouter)
# KIMI_MODEL=k3
# KIMI_BASE_URL=https://api.kimi.com/coding/v1

# Storage locations (read at call time by backend/eda_tools.py)
# SCPATH   — SiliconCompiler cache (PDK/tool downloads). Default: ~/.local/share/asic-agent
# SC_BUILDS — build outputs (RTL, testbenches, SDC, synthesis results). Default: ./build
# On this machine both live on the big HDD:
SCPATH=/mnt/cold-hdd/siliconcompiler
SC_BUILDS=/mnt/cold-hdd/sc_builds

# Tiny Tapeout local hardening (optional)
# TT_PYTHON must contain LibreLane and the tt-support-tools dependencies.
# TAPEOUT_BUILDS stores isolated staged hardening workspaces.
# PDK_ROOT stores Ciel-managed PDK data; PDK selects the installed variant.
TT_PYTHON=/absolute/path/to/project/.tools/tt-venv/bin/python
TAPEOUT_BUILDS=/absolute/path/to/tapeout-builds
PDK_ROOT=/absolute/path/to/tt-pdk
PDK=sky130A
# Pin the exact LibreLane container used by evidence-producing hardening runs.
TAPEOUT_CONTAINER_IMAGE=ghcr.io/librelane/librelane:3.0.14
TAPEOUT_CONTAINER_DIGEST=sha256:f91b21d75f79871f9ccf37451020b5d2f7b3236881a997ff709c561e8280a30f

# Fail-closed per-chat cost and timing limits (optional defaults shown)
# Per-run provider-token ceiling. Prompt estimates are reserved before calls.
# AGENT_CHAT_TOKEN_BUDGET=120000
# Maximum completion allowance for one provider generation.
# AGENT_MODEL_OUTPUT_TOKEN_LIMIT=32768
# AGENT_MAX_TIMING_VIOLATIONS=2
# AGENT_MAX_SYNTHESIS_INVOCATIONS=3
# AGENT_MAX_NON_IMPROVING_ATTEMPTS=2
# AGENT_MAX_FULL_PNR_INVOCATIONS=1

# Phase 2 bounded model context (optional defaults shown)
# These limits apply only to provider-facing prompts; durable project history
# and full tool artifacts remain persisted. Values are character/message limits
# except *_LIMIT and TOKEN_ESTIMATE_BYTES_PER_TOKEN, which are estimated tokens.
# AGENT_MODEL_CONTEXT_MAX_CHARS=120000
# AGENT_MODEL_CONTEXT_ARTIFACT_MAX_CHARS=70000
# AGENT_MODEL_CONTEXT_DIAGNOSTIC_MAX_CHARS=14000
# AGENT_MODEL_CONTEXT_RECENT_MESSAGES=6
# AGENT_MODEL_CONTEXT_USER_MAX_CHARS=24000
# AGENT_CONTEXT_SOFT_LIMIT=180000
# AGENT_CONTEXT_HARD_LIMIT=200000
# AGENT_TOKEN_ESTIMATE_BYTES_PER_TOKEN=4

# Logging level (DEBUG/INFO/WARNING). Default: INFO
# LOG_LEVEL=INFO
