      "refreshed physical implementation evidence",
      "final core selection"
    ],
    "repairs": [
      "propagate OBI response errors and strict alignment faults",
      "restore sixteen PMP regions with byte-enable-aware data checks",
      "return deterministic denied-fetch responses and latch faults through trap redirection",
      "check aligned architectural instructions over their decoded 2- or 4-byte length",
      "reject fully inaccessible instruction words before issuing a bus request"
    ],
    "reproducibility": "Two complete 45-case runs produced byte-identical result manifests."
  },
