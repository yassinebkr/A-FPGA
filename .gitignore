# Secrets — never commit
.env
.env.*
!*.env.example

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Node
node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
coverage/

# Runtime data
build/
*.vcd
*.log

# Project-local EDA binaries and source builds
.tools/

# Tiny Tapeout template workspace (third-party template)
tapeout/

# Backend runtime state (projects contain prompts, generated HDL, and logs)
backend/data/
backend/logs/
backend/projects/*
!backend/projects/.gitkeep
